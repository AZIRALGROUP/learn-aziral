/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/deployment.json
  Cache-Control: no-store

/instructor
  X-Robots-Tag: noindex, nofollow
/instructor/*
  X-Robots-Tag: noindex, nofollow
/profile
  X-Robots-Tag: noindex, nofollow
/profile/*
  X-Robots-Tag: noindex, nofollow
/practice/*
  X-Robots-Tag: noindex, nofollow
/login
  X-Robots-Tag: noindex, nofollow
/register
  X-Robots-Tag: noindex, nofollow
/courses/:course/learn
  X-Robots-Tag: noindex, nofollow
/courses/:course/learn/*
  X-Robots-Tag: noindex, nofollow
