# Copy values into .env.telegram.local, which is ignored by Git. Requires Node 24+.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Learn_Aziral_bot
MINI_APP_URL=https://learn-bot.aziral.com/telegram
TELEGRAM_PORT=3002
TELEGRAM_DATABASE=telegram/data/learn.sqlite
TELEGRAM_WEBHOOK_SECRET=
GEMINI_API_KEY=
# Set true ONLY after checking that the Gemini project is on Free tier without billing.
GEMINI_FREE_TIER_CONFIRMED=false
# Optional local browser preview, loopback only. Never set in production or behind a tunnel.
TELEGRAM_DEV_MODE=false

# Production connection to the website API within Docker.
SITE_API_URL=http://aziral-api:3001
# Must match LEARN_BRIDGE_SECRET in the website API environment.
LEARN_BRIDGE_SECRET=
