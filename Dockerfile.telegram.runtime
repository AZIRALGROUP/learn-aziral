FROM node:24-alpine
ENV NODE_ENV=production TELEGRAM_PORT=3002 TELEGRAM_DATABASE=/data/learn.sqlite
WORKDIR /app
COPY dist ./dist
COPY telegram/*.mjs ./telegram/
USER node
EXPOSE 3002
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD node -e "fetch('http://127.0.0.1:3002/api/telegram/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "telegram/server.mjs"]
